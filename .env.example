# Transaction pooler (port 6543) — app runtime. Keep ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.<ref>:<url-encoded-password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Session pooler (port 5432) — migrations
DIRECT_URL="postgresql://postgres.<ref>:<url-encoded-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Repair PIN/pattern encryption key — `openssl rand -base64 32`. Keep it safe: losing it makes stored PINs unreadable.
CREDENTIAL_KEY=""
# Bearer token for /api/cron/* (set the same value in Vercel)
CRON_SECRET=""
# Text.lk SMS (leave empty to queue messages without sending)
TEXTLK_API_TOKEN=""
TEXTLK_SENDER_ID=""
# Web Push for the installed app — `npx web-push generate-vapid-keys`. Empty = phone notifications off.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# mailto:you@yourshop.lk or https://<your-app>.vercel.app (Apple rejects an empty or localhost subject)
VAPID_SUBJECT=""
